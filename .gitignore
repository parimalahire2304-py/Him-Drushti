# ============================================================
# .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Environments / secrets ---
.env
.env.*
!.env.example

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# --- Jupyter ---
.ipynb_checkpoints/
*_nbconvert_*

# --- Data (large or generated) ---
# Raw, interim, and processed data are typically too large
# or sensitive to commit. Keep .gitkeep files.
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# --- Model artifacts (large binary) ---
models_artifacts/*
!models_artifacts/.gitkeep

# --- Outputs (generated) ---
outputs/*
!outputs/environment/.gitkeep
!outputs/icebergs/.gitkeep
!outputs/trajectories/.gitkeep
!outputs/forecasts/.gitkeep
!outputs/risk/.gitkeep
!outputs/routes/.gitkeep
!outputs/evaluation/.gitkeep
!outputs/logs/.gitkeep

# --- Test / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# --- Logs ---
*.log
outputs/logs/*.log

# --- OS ---
Thumbs.db
Desktop.ini
