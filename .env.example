# ============================================================
# Environment variable template
# Copy to .env and fill in values for your deployment.
# NEVER commit the .env file. Secrets must not be hard-coded.
# ============================================================

# --- MQTT (used in later phases; not required for Phase 0) ---
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# --- Data access credentials (used in later phases) ---
# NSIDC
NSIDC_USERNAME=
NSIDC_PASSWORD=

# ECMWF Climate Data Store
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

# CMEMS
CMEMS_USERNAME=
CMEMS_PASSWORD=

# Copernicus Data Space Ecosystem (Sentinel-1 SAR)
# Free account: https://dataspace.copernicus.eu/ (OAuth2 / OData API)
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# --- Logging ---
LOG_LEVEL=INFO
